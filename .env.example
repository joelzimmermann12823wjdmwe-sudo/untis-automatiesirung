# WebUntis Zugangsdaten
WEBUNTIS_SERVER=obs-winsen.webuntis.com
WEBUNTIS_SCHOOL=obs-winsen
WEBUNTIS_USER=dein_webuntis_benutzername

# IServ SSO Login (statt WebUntis-Passwort)
ISERV_SERVER=schuleimallertal.de
ISERV_PASSWORD=dein_iserv_passwort

# ntfy.sh Push-Benachrichtigungen (kostenlos, kein Account nötig)
# App installieren: https://ntfy.sh, dann eigenes Topic wählen
NTFY_TOPIC=dein-eigenes-topic

# Überwachungs-Einstellungen
POLL_INTERVAL=120
LOG_LEVEL=INFO
CACHE_FILE=/tmp/timetable_cache.json
